# From Supabase: Project Settings > API Keys / Data API
SUPABASE_URL=https://your-project.supabase.co
# The secret key (or the legacy "service_role" key). Keep it private: server only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# The public (publishable) key. Only used so the browser can upload Idea Bank attachments.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional. Emails that can always sign in to the admin side (comma separated).
ADMIN_EMAILS=you@example.com
# Optional backup if email codes do not arrive: a long secret passcode (12+ characters).
ADMIN_PASSCODE=
# Optional. Signs the admin cookie. If empty, the secret key above is used.
ADMIN_SESSION_SECRET=
